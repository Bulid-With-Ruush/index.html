<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

<style>
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html { scroll-behavior: smooth; }

body {
  background: #080808;
  color: white;
  font-family: 'Inter', sans-serif;
  overflow-x: hidden;
}

body::before {
  content: "";
  position: fixed;
  inset: 0;
  background-image:
    linear-gradient(#ffffff08 1px, transparent 1px),
    linear-gradient(90deg, #ffffff08 1px, transparent 1px);
  background-size: 55px 55px;
  mask-image: linear-gradient(to bottom, black, transparent);
  pointer-events: none;
}

nav {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28px 8%;
  position: relative;
  z-index: 5;
}

.logo {
  font-size: 22px;
  font-weight: 900;
  letter-spacing: -1px;
}

.logo span { color: #ff3030; }

nav a {
  color: #aaa;
  text-decoration: none;
  margin-left: 25px;
  font-size: 12px;
  transition: .3s;
}

nav a:hover { color: #ff3030; }

.hero {
  min-height: 700px;
  padding: 90px 8% 60px;
  position: relative;
  display: flex;
  align-items: center;
  perspective: 1000px;
}

.hero-content {
  position: relative;
  z-index: 2;
  width: 100%;
}

.eyebrow {
  color: #ff4949;
  letter-spacing: 5px;
  font-size: 11px;
  font-weight: 800;
  margin-bottom: 20px;
}

.big-title {
  font-size: clamp(75px, 15vw, 190px);
  font-weight: 900;
  letter-spacing: -12px;
  line-height: .85;
  text-transform: uppercase;
  background: linear-gradient(180deg, #ff7777, #ed111b 55%, #740000);
  -webkit-background-clip: text;
  color: transparent;
  filter: drop-shadow(0 10px 40px #ff000044);
}

.profile {
  display: flex;
  align-items: center;
  gap: 35px;
  margin-top: -10px;
  position: relative;
  z-index: 3;
}

.portrait {
  width: 230px;
  height: 310px;
  background:
    radial-gradient(ellipse at 50% 30%, #6b3030, #211414 55%, #080808);
  border: 1px solid #ffffff20;
  border-radius: 120px 120px 15px 15px;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 0 90px #ff202033;
}

.portrait span {
  font-size: 70px;
  font-weight: 900;
  color: #ff5555;
  text-shadow: 0 0 35px #ff0000;
}

.intro h1 {
  font-size: clamp(35px, 5vw, 65px);
  line-height: 1;
  font-weight: 900;
}

.intro h1 span { color: #ff3434; }

.intro p {
  color: #999;
  max-width: 400px;
  line-height: 1.8;
  font-size: 13px;
  margin: 18px 0;
}

.btn {
  display: inline-block;
  padding: 13px 22px;
  background: #ed2525;
  color: white;
  border-radius: 5px;
  text-decoration: none;
  font-size: 12px;
  font-weight: 800;
  transition: .3s;
}

.btn:hover {
  background: white;
  color: #111;
  transform: translateY(-4px);
}

.floating-card {
  position: absolute;
  right: 9%;
  bottom: 80px;
  width: 300px;
  padding: 23px;
  border: 1px solid #ffffff25;
  background: #171717d9;
  backdrop-filter: blur(15px);
  border-radius: 12px;
  box-shadow: 0 20px 70px #000;
  transform: rotateY(-10deg) rotateX(5deg);
}

.card-label {
  font-size: 9px;
  letter-spacing: 3px;
  color: #ff5555;
  margin-bottom: 14px;
}

.floating-card h3 { font-size: 17px; }

.floating-card p {
  color: #999;
  font-size: 11px;
  margin-top: 10px;
  line-height: 1.7;
}

.stats {
  display: flex;
  gap: 12px;
  margin-top: 20px;
}

.stat {
  flex: 1;
  background: #252525;
  padding: 15px 8px;
  border-radius: 7px;
  text-align: center;
}

.stat h2 {
  color: #ff4141;
  font-size: 23px;
}

.stat p {
  font-size: 9px;
  margin: 5px 0 0;
}

section {
  padding: 100px 8%;
  position: relative;
}

.section-title {
  font-size: clamp(35px, 6vw, 65px);
  font-weight: 900;
  margin-bottom: 40px;
}

.section-title span { color: #ff3434; }

.about-text {
  max-width: 650px;
  color: #999;
  line-height: 2;
  font-size: 15px;
}

.projects {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
  gap: 20px;
}

.project {
  background: #121212;
  border: 1px solid #292929;
  padding: 30px;
  border-radius: 12px;
  transition: .3s;
}

.project:hover {
  border-color: #ff3434;
  transform: translateY(-8px);
}

.project small {
  color: #ff4141;
  letter-spacing: 3px;
}

.project h3 {
  margin: 20px 0 12px;
  font-size: 21px;
}

.project p {
  color: #999;
  font-size: 12px;
  line-height: 1.8;
}

.skills {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
}

.skill {
  padding: 14px 23px;
  background: #151515;
  border: 1px solid #333;
  border-radius: 5px;
  font-size: 13px;
  transition: .3s;
}

.skill:hover {
  background: #ed2525;
  border-color: #ed2525;
}

.contact {
  text-align: center;
}

.contact p {
  color: #999;
  margin: 20px 0 30px;
}

footer {
  border-top: 1px solid #222;
  padding: 30px 8%;
  color: #666;
  font-size: 11px;
  display: flex;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 15px;
}

footer span { color: #ff3434; }

.reveal {
  opacity: 0;
  transform: translateY(35px);
  transition: .8s ease;
}

.reveal.visible {
  opacity: 1;
  transform: translateY(0);
}

@media(max-width: 800px) {
  .hero { padding-top: 70px; min-height: 850px; }
