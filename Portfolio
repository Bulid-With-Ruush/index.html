  nav a { margin-left: 10px; font-size: 10px; }
  section { padding: 70px 8%; }
}

@media(max-width: 430px) {
  nav { padding: 22px 5%; }
  nav a { margin-left: 7px; }
  .hero { padding-left: 5%; padding-right: 5%; }
}
</style>
</head>

